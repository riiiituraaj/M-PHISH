{
  // Python backend: the Python extension auto-detects ./.venv on Windows, macOS and Linux.
  "python.envFile": "${workspaceFolder}/.env",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["backend/tests", "-q"],
  "python.testing.cwd": "${workspaceFolder}",

  // The project lints and formats with Ruff (line length 100, see pyproject.toml).
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.rulers": [100]
  },

  // web/ and extension/ each have their own tsconfig and node_modules.
  "typescript.tsdk": "web/node_modules/typescript/lib",

  "files.exclude": {
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.venv": true,
    "**/package-lock.json": true,
    "docs/dependency-audit-*.json": true
  }
}
