{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: migrate database",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "alembic", "-c", "backend/alembic.ini", "upgrade", "head"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "DATABASE_URL": "sqlite:///backend/m_phish.db" }
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: lint (ruff)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "ruff", "check", "backend/app", "backend/tests"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Backend: tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
      "args": ["-m", "pytest", "backend/tests", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Web: tests",
      "type": "npm",
      "script": "test",
      "path": "web",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Web: typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "web",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Extension: tests",
      "type": "npm",
      "script": "test",
      "path": "extension",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Extension: typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "extension",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Extension: build",
      "type": "npm",
      "script": "build",
      "path": "extension",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "All checks",
      "dependsOn": [
        "Backend: lint (ruff)",
        "Backend: tests",
        "Web: tests",
        "Web: typecheck",
        "Extension: tests",
        "Extension: typecheck"
      ],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
